# Social Rank supplier
SOCIAL_RANK_API_KEY=REPLACE_WITH_YOUR_ROTATED_SOCIAL_RANK_KEY
SOCIAL_RANK_API_URL=https://www.socialranksmmpannel.com/api/v2

# Local only; Vercel supplies its own runtime port
PORT=3000

# Upstream reliability
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_READ_RETRIES=2
SERVICE_CACHE_TTL_MS=60000

# Security secrets - generate fresh random values; never commit them
DROPZONE_APP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
INTERNAL_API_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# CORS: comma-separated exact origins.
# Leave empty only for local/server-to-server development.
ALLOWED_ORIGINS=

# Request/rate limits
MAX_BODY_BYTES=262144
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
